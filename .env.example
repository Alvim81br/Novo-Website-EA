# Credenciais públicas do Supabase (Project Settings → API)
# A anon key é segura para uso no navegador: a tabela leads possui RLS
# permitindo apenas INSERT (veja supabase/schema.sql).
PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Medição (opcional — também pode ser preenchida em src/data/site.ts).
# Com GTM preenchido, GA4 e Pixel devem ser tags DENTRO do contêiner
# (o site não os carrega direto, para não medir em dobro).
# Nada é carregado antes de o visitante aceitar os cookies (LGPD).
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=
