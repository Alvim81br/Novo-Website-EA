---
// Selo de avaliações do Google (prova social). Só aparece quando os números
// reais estiverem preenchidos em site.googleReviews (src/data/site.ts) —
// nunca exiba nota estimada. Usado ao lado do formulário de leads.
import { site } from '../data/site';

const { rating, count, url } = site.googleReviews;
const show = rating > 0 && count > 0;
const fullStars = Math.round(rating);
const label = `${rating.toFixed(1).replace('.', ',')} de 5 no Google, com base em ${count} avaliações`;
---

{
  show && (
    <div class="flex items-center gap-3 rounded-2xl border border-gray-200 bg-gray-50 px-4 py-3">
      <div class="flex gap-0.5" role="img" aria-label={label}>
        {Array.from({ length: 5 }).map((_, i) => (
          <svg
            class:list={['h-5 w-5', i < fullStars ? 'text-gold-400' : 'text-gray-300']}
            fill="currentColor"
            viewBox="0 0 20 20"
            aria-hidden="true"
          >
            <path d="M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.07 3.3a1 1 0 0 0 .95.69h3.46c.97 0 1.37 1.24.59 1.81l-2.8 2.03a1 1 0 0 0-.36 1.12l1.07 3.3c.3.92-.76 1.69-1.54 1.12l-2.8-2.03a1 1 0 0 0-1.18 0l-2.8 2.03c-.78.57-1.84-.2-1.54-1.12l1.07-3.3a1 1 0 0 0-.36-1.12L2.98 8.73c-.78-.57-.38-1.81.59-1.81h3.46a1 1 0 0 0 .95-.69l1.07-3.3z" />
          </svg>
        ))}
      </div>
      <p class="text-sm leading-tight text-gray-700">
        <strong class="text-navy-800">{rating.toFixed(1).replace('.', ',')}</strong> no Google ·{' '}
        {url ? (
          <a href={url} target="_blank" rel="noopener" class="font-semibold text-navy-700 underline">
            {count}+ avaliações
          </a>
        ) : (
          <span>{count}+ avaliações</span>
        )}
      </p>
    </div>
  )
}
