---
// Ícones próprios da English Academy — traço contínuo, cantos arredondados,
// grade de 24x24 e cor herdada (currentColor), no mesmo estilo dos ícones já
// usados na Home. Para adicionar um ícone, inclua uma entrada em `icons`.
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = 'h-6 w-6' } = Astro.props;

const icons: Record<string, string> = {
  // ===== Pilares da metodologia =====
  /** Balão de fala com ondas sonoras — conversação */
  conversacao: `
    <rect x="2.5" y="4" width="12.5" height="9.5" rx="3"/>
    <path d="M6.5 13.5V17l4-3.5"/>
    <path d="M18.2 8.8a4.2 4.2 0 0 1 0 6.4"/>
    <path d="M20.8 6.2a7.6 7.6 0 0 1 0 11.6"/>`,
  /** Cronômetro — aprender em 1/4 do tempo */
  cronometro: `
    <circle cx="12" cy="13.8" r="7.7"/>
    <path d="M12 9.8v4.2l2.6 1.8"/>
    <path d="M9.5 2.6h5"/>
    <path d="M12 2.6v3.5"/>
    <path d="M18.9 7.6 20.3 6.2"/>`,
  /** Halter — treinar, não só estudar */
  halter: `
    <path d="M6.8 7.2v9.6"/>
    <path d="M3.6 9.4v5.2"/>
    <path d="M17.2 7.2v9.6"/>
    <path d="M20.4 9.4v5.2"/>
    <path d="M6.8 12h10.4"/>`,
  /** Escada ascendente — metodologia estruturada, nível a nível */
  escada: `
    <path d="M3 20h5v-5h5v-5h5V5"/>
    <path d="M16.5 5H21v4.5"/>`,
  /** Grupo de pessoas — rodízio de professores */
  professores: `
    <circle cx="9" cy="8" r="3.1"/>
    <path d="M3.4 18.6a5.6 5.6 0 0 1 11.2 0"/>
    <path d="M16.2 5.4a3.1 3.1 0 0 1 0 5.6"/>
    <path d="M17.6 13.7a5.1 5.1 0 0 1 3 4.9"/>`,
  /** Celular — app exclusivo */
  celular: `
    <rect x="6.6" y="2.5" width="10.8" height="19" rx="2.6"/>
    <path d="M10.6 5.4h2.8"/>
    <path d="M11 18.4h2"/>`,

  // ===== Garantia de fluência =====
  /** Documento com visto — compromisso firmado */
  compromisso: `
    <path d="M14 3.2H7.4a2.2 2.2 0 0 0-2.2 2.2v13.2a2.2 2.2 0 0 0 2.2 2.2h9.2a2.2 2.2 0 0 0 2.2-2.2V8.2z"/>
    <path d="M14 3.2v5h4.8"/>
    <path d="M8.8 14.6l2.1 2.1 4.3-4.7"/>`,
  /** Escudo com visto — zero riscos */
  escudo: `
    <path d="M12 2.8 4.6 6v6c0 4.4 3.1 8.1 7.4 9.2 4.3-1.1 7.4-4.8 7.4-9.2V6z"/>
    <path d="M8.9 11.8l2.2 2.2 4.1-4.4"/>`,
  /** Alvo — resultados garantidos */
  alvo: `
    <circle cx="12" cy="12" r="8.2"/>
    <circle cx="12" cy="12" r="4.3"/>
    <circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>`,

  // ===== Extra Class =====
  /** Balão com reticências — clubes de conversação */
  batePapo: `
    <rect x="2.5" y="4" width="19" height="12.6" rx="3"/>
    <path d="M8 16.6v4l4.6-4"/>
    <circle cx="8.6" cy="10.3" r="1" fill="currentColor" stroke="none"/>
    <circle cx="12" cy="10.3" r="1" fill="currentColor" stroke="none"/>
    <circle cx="15.4" cy="10.3" r="1" fill="currentColor" stroke="none"/>`,
  /** Dado — jogos e atividades */
  dado: `
    <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="4"/>
    <circle cx="8.6" cy="8.6" r="1.15" fill="currentColor" stroke="none"/>
    <circle cx="12" cy="12" r="1.15" fill="currentColor" stroke="none"/>
    <circle cx="15.4" cy="15.4" r="1.15" fill="currentColor" stroke="none"/>`,
  /** Quadro de apresentação com gráfico — sextas de apresentação */
  apresentacao: `
    <path d="M3.2 4h17.6"/>
    <path d="M5 4v9.4a1.6 1.6 0 0 0 1.6 1.6h10.8a1.6 1.6 0 0 0 1.6-1.6V4"/>
    <path d="M12 15v3.2"/>
    <path d="M9 20.8 12 18.2l3 2.6"/>
    <path d="M8.8 11.6V9.2M12 11.6V7M15.2 11.6V8.4"/>`,
  /** Tela com play — noites de filmes e séries */
  filme: `
    <rect x="2.5" y="4" width="19" height="13.2" rx="3"/>
    <path d="M10.2 8.4 15 10.6l-4.8 2.2z"/>
    <path d="M8.4 20.6h7.2"/>`,
  /** Notas musicais — música e cultura */
  musica: `
    <path d="M9 18.2V6.4l10.4-2.1v11.6"/>
    <circle cx="6.5" cy="18.2" r="2.6"/>
    <circle cx="16.8" cy="15.9" r="2.6"/>`,
  /** Globo — intercâmbio cultural */
  globo: `
    <circle cx="12" cy="12" r="9"/>
    <path d="M3.3 9.4h17.4M3.3 14.6h17.4"/>
    <path d="M12 3c2.5 2.5 3.9 5.7 3.9 9s-1.4 6.5-3.9 9c-2.5-2.5-3.9-5.7-3.9-9s1.4-6.5 3.9-9z"/>`,

  // ===== Callan App (Callan Student Practice Area) =====
  /** Caneta — ditados, prática de escrita */
  caneta: `
    <path d="M16.4 3.6a2.3 2.3 0 0 1 3.2 3.2L8.4 18h-3.2v-3.2z"/>
    <path d="M14.6 5.4 18 8.8"/>`,
  /** Lista com visto — exercícios de gramática e vocabulário */
  checklist: `
    <path d="M3.4 6.4 5 8l2.8-3"/>
    <path d="M3.4 13.4 5 15l2.8-3"/>
    <path d="M3.6 20.4h2"/>
    <path d="M11 7h9.4M11 14h9.4M11 20.4h9.4"/>`,
  /** Headphone — áudio das lições */
  fone: `
    <path d="M4 14v-2a8 8 0 0 1 16 0v2"/>
    <path d="M4 14.4h2.2a1.6 1.6 0 0 1 1.6 1.6v2.6a1.6 1.6 0 0 1-1.6 1.6H5.6A1.6 1.6 0 0 1 4 18.6z"/>
    <path d="M20 14.4h-2.2a1.6 1.6 0 0 0-1.6 1.6v2.6a1.6 1.6 0 0 0 1.6 1.6h.8a1.6 1.6 0 0 0 1.6-1.6z"/>`,

  // ===== Reservados para o app próprio com IA (em desenvolvimento) =====
  // Ver docs/app-ia-conteudo-futuro.md
  /** Balão arredondado com brilho — conversação com IA */
  iaChat: `
    <path d="M20.6 11.7a8.4 8.4 0 0 1-12.3 7.5L3.6 20.6l1.4-4.6a8.4 8.4 0 1 1 15.6-4.3z"/>
    <path d="m12 8.2 1 2.3 2.3 1-2.3 1-1 2.3-1-2.3-2.3-1 2.3-1z"/>`,
  /** Raio — feedback instantâneo */
  raio: `
    <path d="M13.6 2.6 4.8 13.4h5.8l-1 8 8.8-11h-5.8z"/>`,
  /** Microfone — pronúncia perfeita */
  microfone: `
    <rect x="9" y="2.6" width="6" height="11" rx="3"/>
    <path d="M5.6 11.2a6.4 6.4 0 0 0 12.8 0"/>
    <path d="M12 17.6v3.2"/>
    <path d="M9.2 20.8h5.6"/>`,
  /** Maleta — cenários reais de trabalho e negócios */
  maleta: `
    <rect x="2.6" y="7" width="18.8" height="12.6" rx="2.6"/>
    <path d="M8.6 7V5.6a2 2 0 0 1 2-2h2.8a2 2 0 0 1 2 2V7"/>
    <path d="M2.6 12.6h18.8"/>
    <path d="M10.4 12.6h3.2"/>`,
  /** Livro aberto — vocabulário */
  livro: `
    <path d="M4 4.6h5.6A2.9 2.9 0 0 1 12 7.5v12a2.4 2.4 0 0 0-2.4-2.4H4z"/>
    <path d="M20 4.6h-5.6A2.9 2.9 0 0 0 12 7.5v12a2.4 2.4 0 0 1 2.4-2.4H20z"/>`,
  /** Gráfico em alta — progresso integrado */
  progresso: `
    <path d="M3.4 20.6h17.2"/>
    <path d="m6 16.4 4-4.6 3.4 3 5-6.4"/>
    <path d="M14.8 8.4h3.6V12"/>`,
};

const path = icons[name] ?? '';
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={path}
/>
