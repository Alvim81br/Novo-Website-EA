---
import { units, listedUnits, defaultWhatsappLink } from '../data/units';

// Credenciais PÚBLICAS do Supabase (anon key + RLS de INSERT apenas — seguras no
// cliente; ver supabase/schema.sql). Projeto english-academy-leads.
// Fixas de propósito: valores colados no painel do Vercel podem carregar espaços/
// quebras de linha invisíveis que corrompem o header Authorization e fazem o envio
// falhar antes de chegar ao Supabase. Como a anon key é pública por design, mantê-la
// aqui é seguro e elimina essa classe de erro.
const supabaseUrl = 'https://kitekwfjytbewwqatmit.supabase.co';
const supabaseAnonKey =
  'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtpdGVrd2ZqeXRiZXd3cWF0bWl0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODEyMDEzMjgsImV4cCI6MjA5Njc3NzMyOH0.Lr7hjFTOBYaB5ArYLx9lMm9z3xCUgPjCZE6DdDbIUBg';

// Número do WhatsApp da matriz (fonte única: units.ts), usado no fallback sem Supabase.
const waNumber = defaultWhatsappLink.match(/wa\.me\/(\d+)/)?.[1] ?? '';

// Mapa unidade → número: o fallback de WhatsApp fala com a unidade que a
// pessoa escolheu no formulário (e não sempre com a matriz).
const waNumberByUnit = Object.fromEntries(
  units.map((unit) => [unit.name, unit.whatsappLink.match(/wa\.me\/(\d+)/)?.[1] ?? waNumber])
);

const courses = [
  'Inglês para Adultos',
  'Inglês para Adolescentes (Teens)',
  'Inglês para Crianças (Kids)',
  'Online e ao Vivo (EA Live)',
  'Espanhol',
];

const schedules = ['Manhã', 'Tarde', 'Noite', 'Sábado'];

interface Props {
  /** Nome da unidade pré-selecionada (usado nas landing pages por cidade). */
  defaultUnit?: string;
}
const { defaultUnit } = Astro.props;
---

<form
  id="lead-form"
  class="space-y-5"
  data-supabase-url={supabaseUrl}
  data-supabase-key={supabaseAnonKey}
  data-wa-number={waNumber}
  data-wa-by-unit={JSON.stringify(waNumberByUnit)}
  novalidate
>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="lead-name" class="mb-1.5 block text-sm font-bold text-navy-800">Nome completo *</label>
      <input
        type="text"
        id="lead-name"
        name="name"
        required
        autocomplete="name"
        placeholder="Seu nome"
        class="w-full rounded-xl border border-gray-300 px-4 py-3 text-gray-800 transition focus:border-navy-700 focus:ring-2 focus:ring-navy-200 focus:outline-none"
      />
    </div>
    <div>
      <label for="lead-phone" class="mb-1.5 block text-sm font-bold text-navy-800">WhatsApp *</label>
      <input
        type="tel"
        id="lead-phone"
        name="phone"
        required
        autocomplete="tel"
        placeholder="(94) 9 9999-9999"
        pattern={'[0-9 \\(\\)\\+\\.\\-]{10,20}'}
        title="Digite um WhatsApp válido com DDD, ex.: (94) 99999-9999"
        class="w-full rounded-xl border border-gray-300 px-4 py-3 text-gray-800 transition focus:border-navy-700 focus:ring-2 focus:ring-navy-200 focus:outline-none"
      />
    </div>
  </div>

  <!-- Honeypot anti-spam: campo invisível que humanos não preenchem -->
  <div style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden" aria-hidden="true">
    <label for="lead-website">Não preencha este campo</label>
    <input type="text" id="lead-website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="lead-unit" class="mb-1.5 block text-sm font-bold text-navy-800">Unidade mais próxima *</label>
      <select
        id="lead-unit"
        name="unit"
        required
        class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-gray-800 transition focus:border-navy-700 focus:ring-2 focus:ring-navy-200 focus:outline-none"
      >
        <option value="" disabled selected={!defaultUnit}>Selecione a unidade</option>
        {listedUnits.map((unit) => <option value={unit.name} selected={unit.name === defaultUnit}>{unit.name}</option>)}
      </select>
    </div>
    <div>
      <label for="lead-course" class="mb-1.5 block text-sm font-bold text-navy-800">Curso de interesse *</label>
      <select
        id="lead-course"
        name="course"
        required
        class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-gray-800 transition focus:border-navy-700 focus:ring-2 focus:ring-navy-200 focus:outline-none"
      >
        <option value="" disabled selected>Selecione o curso</option>
        {courses.map((course) => <option value={course}>{course}</option>)}
      </select>
    </div>
  </div>

  <div>
    <label for="lead-schedule" class="mb-1.5 block text-sm font-bold text-navy-800">Melhor horário para estudar</label>
    <select
      id="lead-schedule"
      name="schedule"
      class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-gray-800 transition focus:border-navy-700 focus:ring-2 focus:ring-navy-200 focus:outline-none"
    >
      <option value="" selected>Sem preferência</option>
      {schedules.map((s) => <option value={s}>{s}</option>)}
    </select>
  </div>

  <button
    type="submit"
    class="w-full rounded-full bg-red-ea px-8 py-4 text-base font-bold text-white shadow-lg transition hover:bg-red-ea-dark hover:shadow-xl disabled:cursor-not-allowed disabled:opacity-60"
  >
    Quero Minha Aula Experimental Grátis
  </button>

  <p id="lead-feedback" class="hidden rounded-xl px-4 py-3 text-sm font-semibold" role="status"></p>

  <p class="text-center text-xs text-gray-500">
    Ao enviar, você autoriza nosso contato pelo WhatsApp para agendar sua aula, conforme a
    <a href="/politica-de-privacidade/" class="font-bold text-navy-700 underline">Política de Privacidade</a>.
    Prefere falar direto?
    <a href={defaultWhatsappLink} target="_blank" rel="noopener" class="font-bold text-navy-700 underline">
      Chame no WhatsApp
    </a>.
  </p>
</form>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  const feedback = document.getElementById('lead-feedback');

  function showFeedback(message: string, ok: boolean) {
    if (!feedback) return;
    feedback.textContent = message;
    feedback.classList.remove('hidden', 'bg-green-50', 'text-green-800', 'bg-red-50', 'text-red-800');
    feedback.classList.add(ok ? 'bg-green-50' : 'bg-red-50', ok ? 'text-green-800' : 'text-red-800');
  }

  // Parâmetros de campanha guardados na chegada ao site (ver BaseLayout).
  function getUtm(): Record<string, string> {
    try {
      return JSON.parse(sessionStorage.getItem('ea-utm') ?? '{}');
    } catch {
      return {};
    }
  }

  // Evento de conversão (GA4/GTM/Meta) — no-op seguro se a medição não estiver ativa.
  function track(name: string, params?: Record<string, unknown>) {
    (window as any).eaTrack?.(name, params);
  }

  // Número de WhatsApp da unidade escolhida (fallback: matriz).
  function waNumberFor(unit: string): string {
    try {
      const map = JSON.parse(form?.dataset.waByUnit ?? '{}') as Record<string, string>;
      return map[unit] || form?.dataset.waNumber || '';
    } catch {
      return form?.dataset.waNumber || '';
    }
  }

  // Encaminha o lead para o WhatsApp da unidade escolhida (caminho de emergência).
  function sendViaWhatsApp(data: Record<string, FormDataEntryValue>) {
    const text = encodeURIComponent(
      `Olá! Quero agendar uma aula experimental gratuita.\n\nNome: ${data.name}\nWhatsApp: ${data.phone}\nUnidade: ${data.unit}\nCurso: ${data.course}\nHorário: ${data.schedule || 'Sem preferência'}`
    );
    window.open(`https://wa.me/${waNumberFor(String(data.unit))}?text=${text}`, '_blank');
    track('generate_lead', { method: 'whatsapp_fallback', unit: data.unit });
    try {
      sessionStorage.setItem('ea-lead-fired', '1');
    } catch {}
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const { supabaseUrl, supabaseKey } = form.dataset;
    const data = Object.fromEntries(new FormData(form).entries());
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;

    // Honeypot: bots preenchem o campo oculto — finge sucesso e descarta
    // (sem redirecionar nem disparar evento, para não sujar as métricas).
    if (data.website) {
      form.reset();
      showFeedback('Recebemos seu pedido! 🎉 Nossa equipe vai te chamar no WhatsApp em breve.', true);
      return;
    }

    if (!supabaseUrl || !supabaseKey) {
      // Supabase ainda não configurado: encaminha o lead para o WhatsApp.
      sendViaWhatsApp(data);
      showFeedback('Estamos te redirecionando para o WhatsApp para concluir o agendamento. 😊', true);
      return;
    }

    button.disabled = true;
    button.textContent = 'Enviando...';

    try {
      const utm = getUtm();
      const response = await fetch(`${supabaseUrl}/rest/v1/leads`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          apikey: supabaseKey,
          Authorization: `Bearer ${supabaseKey}`,
          Prefer: 'return=minimal',
        },
        body: JSON.stringify({
          name: data.name,
          phone: data.phone,
          unit: data.unit,
          course: data.course,
          schedule: data.schedule || null,
          source: window.location.pathname,
          // Origem da campanha (colunas criadas em supabase/schema.sql)
          utm_source: utm.utm_source ?? null,
          utm_medium: utm.utm_medium ?? null,
          utm_campaign: utm.utm_campaign ?? null,
          utm_term: utm.utm_term ?? null,
          utm_content: utm.utm_content ?? null,
          gclid: utm.gclid ?? null,
          fbclid: utm.fbclid ?? null,
        }),
      });

      if (!response.ok) {
        const detail = await response.text().catch(() => '');
        throw new Error(`Supabase respondeu ${response.status} ${detail}`);
      }

      // Sucesso → página de obrigado, onde o evento generate_lead é disparado
      // (é ela que GA4/Meta usam como ponto de conversão das campanhas).
      track('lead_form_submit', { unit: data.unit });
      window.location.assign(
        `/obrigado/?u=${encodeURIComponent(String(data.unit))}&via=form`
      );
      return;
    } catch (error) {
      // Se o salvamento falhar por qualquer motivo (rede, bloqueio, etc.), não
      // perdemos o lead: encaminhamos os dados para o WhatsApp da unidade escolhida.
      console.error(error);
      sendViaWhatsApp(data);
      showFeedback(
        'Estamos te levando ao WhatsApp para concluir seu agendamento agora mesmo. 😊',
        true
      );
    } finally {
      button.disabled = false;
      button.textContent = 'Quero Minha Aula Experimental Grátis';
    }
  });
</script>
