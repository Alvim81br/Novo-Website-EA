---
// Logomarca oficial da English Academy: escudo (WebP otimizado em /public/logo-ea.webp)
// com wordmark na tipografia da marca — "ENGLISH" em Cinzel (serifada clássica,
// branca) e "ACADEMY" em Nunito Bold (dourada).
interface Props {
  class?: string;
}
const { class: className = 'h-10' } = Astro.props;

// "ACADEMY" é renderizada letra a letra e distribuída (justify-between) dentro de
// 95% da largura de "ENGLISH", ficando centralizada sob ela. As proporções seguem
// a arte oficial: altura ~48% e largura ~96% das de "ENGLISH".
const academy = [...'ACADEMY'];
---

<span class={`flex items-center gap-3 ${className}`}>
  <img
    src="/logo-ea.webp"
    alt="English Academy"
    class="h-full w-auto drop-shadow-sm"
    width="288"
    height="320"
    loading="eager"
    decoding="async"
    onerror="this.style.display='none'"
  />
  <span
    class="flex translate-y-[0.024em] flex-col items-stretch justify-center leading-none"
    aria-hidden="true"
  >
    <span class="font-brand text-[1.2em] font-bold text-white">ENGLISH</span>
    <span class="font-logo mx-auto flex w-[95%] justify-between text-[0.58em] font-bold text-[#CFA13F]">
      {academy.map((letra) => <span>{letra}</span>)}
    </span>
  </span>
</span>
