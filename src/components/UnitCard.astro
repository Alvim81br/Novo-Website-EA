---
import type { Unit } from '../data/units';

interface Props {
  unit: Unit;
}
const { unit } = Astro.props;

// Nome da unidade sempre em 2 linhas, para que todos os cards fiquem alinhados
// (quebra no travessão: "Parauapebas —" / "Cidade Nova"; sem travessão, na
// última palavra: "English Academy" / "Live").
function nomeEmDuasLinhas(nome: string): [string, string] {
  const travessao = nome.indexOf('—');
  if (travessao > -1) {
    return [nome.slice(0, travessao + 1).trim(), nome.slice(travessao + 1).trim()];
  }
  const espaco = nome.lastIndexOf(' ');
  if (espaco > -1) return [nome.slice(0, espaco).trim(), nome.slice(espaco + 1).trim()];
  return [nome, ''];
}
const [nomeLinha1, nomeLinha2] = nomeEmDuasLinhas(unit.name);
---

<article
  id={unit.id}
  class="reveal flex h-full scroll-mt-28 flex-col rounded-2xl border border-gray-100 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-xl"
>
  <div class="flex items-center justify-between gap-3">
    <p class="text-xs font-bold tracking-widest text-red-ea uppercase">{unit.state}</p>
    {
      unit.online ? (
        <span class="rounded-full bg-gold-100 px-3 py-1 text-xs font-bold text-gold-700">Online</span>
      ) : (
        <span class="rounded-full bg-navy-50 px-3 py-1 text-xs font-bold text-navy-700">Presencial</span>
      )
    }
  </div>

  <!-- Duas linhas fixas: mantém a altura do título igual em todos os cards -->
  <h3 class="mt-2 font-display text-lg leading-snug font-bold text-navy-700">
    <span class="block">{nomeLinha1}</span>
    <span class="block">{nomeLinha2 || ' '}</span>
  </h3>

  <p class="mt-3 flex-1 text-sm leading-relaxed text-gray-600">
    <svg class="mr-1 inline h-4 w-4 text-gold-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"></path>
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.14-7.5 11.25-7.5 11.25S4.5 17.64 4.5 10.5a7.5 7.5 0 1 1 15 0z"></path>
    </svg>
    {unit.address}
  </p>

  <div class="mt-4 space-y-1 text-sm text-gray-600">
    <!-- Espaço de 2 telefones reservado em todo card: WhatsApp, Instagram e
         botões ficam na mesma altura em unidades com 1 ou 2 números. -->
    <div class="min-h-[2.75rem] space-y-1">
      {unit.whatsapp.map((number) => <p><span aria-hidden="true">📱</span> {number}</p>)}
    </div>
    <p>
      <a
        href={`https://instagram.com/${unit.instagram}`}
        target="_blank"
        rel="noopener"
        class="text-navy-700 hover:underline"
      >
        @{unit.instagram}
      </a>
    </p>
    {
      unit.hours && unit.hours.length > 0 && (
        <div class="pt-1">
          {unit.hours.map((linha) => (
            <p class="flex items-center gap-1.5">
              <svg
                class="h-4 w-4 shrink-0 text-gold-500"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9" />
                <path stroke-linecap="round" d="M12 7v5l3 2" />
              </svg>
              {linha}
            </p>
          ))}
        </div>
      )
    }
  </div>

  <a
    href={unit.whatsappLink}
    target="_blank"
    rel="noopener"
    class="mt-5 block rounded-full bg-navy-700 px-5 py-3 text-center text-sm font-bold text-white transition hover:bg-navy-600"
  >
    Falar com esta unidade
  </a>
  {
    unit.mapsLink && (
      <a
        href={unit.mapsLink}
        target="_blank"
        rel="noopener"
        class="mt-2 flex items-center justify-center gap-1.5 rounded-full border-2 border-navy-100 px-5 py-2.5 text-center text-sm font-bold text-navy-700 transition hover:border-navy-300 hover:bg-navy-50"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.14-7.5 11.25-7.5 11.25S4.5 17.64 4.5 10.5a7.5 7.5 0 1 1 15 0z" />
        </svg>
        Como chegar
      </a>
    )
  }
  {
    /* Unidade online: ocupa a mesma linha do "Como chegar" das presenciais,
       mantendo todos os cards com a mesma altura de botões. */
    !unit.mapsLink && unit.website && (
      <a
        href={unit.website}
        target="_blank"
        rel="noopener"
        class="mt-2 flex items-center justify-center gap-1.5 rounded-full border-2 border-[#bd21f1] px-5 py-2.5 text-center text-sm font-bold text-[#bd21f1] transition hover:bg-[#bd21f1] hover:text-white"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18" />
        </svg>
        Visitar Website
      </a>
    )
  }
</article>
