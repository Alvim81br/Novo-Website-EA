---
import SectionHeading from './SectionHeading.astro';
import { depoimentos } from '../data/depoimentos';

// Só entram no carrossel os depoimentos com vídeo real (`youtube` ou `mp4`).
// Sem nenhum vídeo publicado, a seção inteira fica oculta — prometer
// "assista" sem nada para assistir derruba a confiança.
const videos = depoimentos.filter((dep) => dep.youtube || dep.mp4);
---

{videos.length > 0 && (
<section class="bg-gray-50 py-20">
  <div class="mx-auto max-w-7xl px-4 lg:px-8">
    <SectionHeading
      eyebrow="Aprenda Inglês de Forma Fácil e Definitiva"
      title="Nossos alunos são nossos maiores exemplos de Sucesso!"
      subtitle="Falar inglês fluente transforma a vida das pessoas de forma extraordinária! Não só o que você coloca no currículo, mas o que você sente quando fala, pensa e se apresenta ao mundo. Assista abaixo a experiência de quem já fala inglês fluente!"
      subtitleShort="Assista abaixo a experiência de quem já fala inglês fluente!"
    />

    <!-- Carrossel: 3 vídeos por vista no desktop, setas para ir e voltar (swipe no mobile) -->
    <div class="reveal relative mx-auto mt-12 max-w-4xl">
      <div
        id="videos-track"
        class="flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2 [scrollbar-width:none] lg:gap-5 [&::-webkit-scrollbar]:hidden"
      >
        {
        videos.map((dep) => (
          <button
            type="button"
            class="group relative aspect-[9/16] w-[58vw] max-w-[230px] shrink-0 snap-center overflow-hidden rounded-2xl shadow-md ring-1 ring-black/5 transition hover:-translate-y-1 hover:shadow-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-red-ea lg:w-[calc((100%-2.5rem)/3)] lg:max-w-none"
            data-video={dep.youtube ?? ''}
            data-mp4={dep.mp4 ?? ''}
            aria-label={`Assistir depoimento${dep.name ? ' de ' + dep.name : ' de aluno'}`}
          >
            {dep.thumb || dep.youtube ? (
              <img
                src={dep.thumb ?? `https://i.ytimg.com/vi/${dep.youtube}/hqdefault.jpg`}
                alt=""
                class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div
                class:list={['absolute inset-0 bg-gradient-to-br', dep.gradient ?? 'from-navy-700 to-navy-900']}
                aria-hidden="true"
              />
            )}

            {/* textura pontilhada sutil sobre os placeholders */}
            {!dep.thumb && !dep.youtube && (
              <div
                class="absolute inset-0 opacity-[0.07]"
                style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 22px 22px;"
                aria-hidden="true"
              />
            )}

            {/* overlay para legibilidade */}
            <div
              class="absolute inset-0 bg-gradient-to-t from-navy-950/70 via-navy-950/10 to-transparent"
              aria-hidden="true"
            />

            {/* selo da marca */}
            <span class="absolute top-2.5 left-2.5 rounded-full bg-white/15 px-2.5 py-0.5 text-[10px] font-bold tracking-wide text-white backdrop-blur-sm">
              English Academy
            </span>

            {/* botão play: círculo vermelho, triângulo branco centrado no viewBox */}
            <span
              class="absolute top-1/2 left-1/2 flex h-14 w-14 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-red-ea text-white shadow-lg transition group-hover:scale-110"
              aria-hidden="true"
            >
              <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M7 6v12l10-6z" />
              </svg>
            </span>

            {(dep.name || dep.caption) && (
              <div class="absolute inset-x-0 bottom-0 p-3 text-left">
                {dep.name && <p class="text-sm font-bold text-white drop-shadow">{dep.name}</p>}
                {dep.caption && <p class="text-xs text-navy-100 drop-shadow">{dep.caption}</p>}
              </div>
            )}
          </button>
        ))
      }
      </div>

      <!-- setas de navegação do carrossel -->
      <button
        type="button"
        id="videos-prev"
        aria-controls="videos-track"
        class="absolute top-1/2 left-1 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/95 text-navy-800 shadow-lg ring-1 ring-black/10 transition hover:bg-navy-800 hover:text-white disabled:pointer-events-none disabled:opacity-35 lg:-left-16"
        aria-label="Vídeo anterior"
        disabled
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button
        type="button"
        id="videos-next"
        aria-controls="videos-track"
        class="absolute top-1/2 right-1 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/95 text-navy-800 shadow-lg ring-1 ring-black/10 transition hover:bg-navy-800 hover:text-white disabled:pointer-events-none disabled:opacity-35 lg:-right-16"
        aria-label="Próximo vídeo"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Lightbox do vídeo -->
  <div
    id="video-modal"
    class="fixed inset-0 z-[60] hidden items-center justify-center bg-navy-950/90 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-label="Depoimento em vídeo"
  >
    <button
      id="video-close"
      class="absolute top-5 right-5 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-2xl text-white transition hover:bg-white/20"
      aria-label="Fechar vídeo"
    >
      ✕
    </button>
    <div class="relative aspect-[9/16] w-full max-w-sm overflow-hidden rounded-2xl bg-black shadow-2xl">
      <iframe
        id="video-frame"
        class="h-full w-full"
        src=""
        title="Depoimento em vídeo"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
      <!-- player para vídeos MP4 hospedados no próprio site -->
      <video id="video-player" class="hidden h-full w-full" controls playsinline preload="none"></video>
    </div>
  </div>
</section>
)}

<script>
  const modal = document.getElementById('video-modal');
  const frame = document.getElementById('video-frame') as HTMLIFrameElement | null;
  const player = document.getElementById('video-player') as HTMLVideoElement | null;
  const closeBtn = document.getElementById('video-close');

  const open = (youtube: string, mp4: string) => {
    if (!modal || !frame || !player) return;
    if (mp4) {
      frame.classList.add('hidden');
      frame.src = '';
      player.classList.remove('hidden');
      player.src = mp4;
      player.play().catch(() => {});
    } else {
      player.classList.add('hidden');
      player.pause();
      player.removeAttribute('src');
      frame.classList.remove('hidden');
      frame.src = `https://www.youtube.com/embed/${youtube}?autoplay=1&rel=0`;
    }
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };
  const close = () => {
    if (!modal || !frame || !player) return;
    frame.src = '';
    player.pause();
    player.removeAttribute('src');
    player.load();
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  };

  document.querySelectorAll<HTMLButtonElement>('[data-video]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const youtube = btn.dataset.video ?? '';
      const mp4 = btn.dataset.mp4 ?? '';
      if (youtube || mp4) open(youtube, mp4);
    });
  });

  closeBtn?.addEventListener('click', close);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) close();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) close();
  });

  // Carrossel: as setas avançam/voltam um card; nas pontas ficam desabilitadas
  const track = document.getElementById('videos-track');
  const prevBtn = document.getElementById('videos-prev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('videos-next') as HTMLButtonElement | null;

  const cardStep = () => {
    if (!track) return 300;
    const card = track.querySelector<HTMLElement>('[data-video]');
    const gap = parseFloat(getComputedStyle(track).columnGap) || 16;
    return (card?.getBoundingClientRect().width ?? 280) + gap;
  };
  const updateArrows = () => {
    if (!track || !prevBtn || !nextBtn) return;
    prevBtn.disabled = track.scrollLeft <= 2;
    nextBtn.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
  };
  const slide = (dir: number) => {
    if (!track) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    track.scrollBy({ left: dir * cardStep(), behavior: reduce ? 'auto' : 'smooth' });
  };

  prevBtn?.addEventListener('click', () => slide(-1));
  nextBtn?.addEventListener('click', () => slide(1));
  track?.addEventListener('scroll', updateArrows, { passive: true });
  window.addEventListener('resize', updateArrows);
  updateArrows();
</script>
