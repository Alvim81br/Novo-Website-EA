---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CTABand from '../../components/CTABand.astro';
import { segments } from '../../data/courses';
import { site } from '../../data/site';
---

<BaseLayout
  title="Cursos de Inglês — Adultos, Adolescentes, Crianças e Online | English Academy"
  description="Encontre sua turma: inglês para adultos, adolescentes (Teens), crianças (Kids) e online ao vivo. Aulas diárias, turmas reduzidas e fluência 4x mais rápida com o Método Callan."
>
  <!-- Hero -->
  <section class="hero-grad-cursos relative flex min-h-[22.25rem] items-center overflow-hidden py-10">
    <div class="absolute inset-0" aria-hidden="true" data-parallax="12">
      <!-- Quadrados arredondados flutuando (blocos de turmas) -->
      <div class="animate-float absolute top-[18%] right-[10%] h-20 w-20 rotate-12 rounded-2xl border-2 border-gold-400/30"></div>
      <div class="animate-float-diamond absolute top-[55%] right-[22%] h-12 w-12 rounded-xl border-2 border-white/20"></div>
      <div class="absolute bottom-[-2rem] right-[38%] h-24 w-24 -rotate-6 rounded-2xl border-2 border-white/10"></div>
      <div class="absolute top-[-2rem] left-[16%] h-16 w-16 rotate-45 rounded-xl border-2 border-red-ea/30"></div>
      <!-- Brilhos -->
      <div class="animate-blob absolute -top-20 left-1/4 h-80 w-80 rounded-full bg-gold-400/15 blur-3xl"></div>
      <div class="animate-blob-slow absolute -bottom-24 -left-16 h-72 w-72 rounded-full bg-red-ea/20 blur-3xl"></div>
      <span class="animate-twinkle absolute top-[30%] right-[30%] text-lg text-gold-300/60">✦</span>
      <span class="animate-twinkle-slow absolute bottom-[24%] left-[28%] text-sm text-white/40">✦</span>
    </div>
    <div class="hero-stagger relative mx-auto w-full max-w-4xl px-4 text-center lg:px-8">
      <p class="text-sm font-bold tracking-widest text-gold-300 uppercase">Encontre aqui a sua turma</p>
      <h1 class="mt-4 text-4xl font-extrabold text-white sm:text-5xl">
        Cursos para cada <span class="text-shimmer">fase da vida</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-navy-100">
        Fale inglês ou espanhol em turmas focadas em adultos, adolescentes e crianças — presenciais ou online
        ao vivo, sempre com o Método Callan.
      </p>
    </div>
  </section>

  <!-- Navegação rápida: a pílula da seção visível fica destacada (scroll-spy no
       script desta página) e, no celular, a barra rola até ela sozinha. -->
  <nav class="sticky top-[68px] z-40 border-b border-gray-100 bg-white/95 backdrop-blur-sm" aria-label="Seções de cursos">
    <div id="cursos-nav" class="mx-auto flex max-w-7xl gap-2 overflow-x-auto px-4 py-3 [scrollbar-width:none] lg:px-8 [&::-webkit-scrollbar]:hidden">
      {
        segments.map((segment) => (
          <a
            href={`#${segment.id}`}
            data-spy-link
            class="shrink-0 rounded-full border border-navy-100 px-4 py-2 text-sm font-semibold text-navy-700 transition hover:bg-navy-50 aria-[current=true]:border-navy-700 aria-[current=true]:bg-navy-700 aria-[current=true]:text-white aria-[current=true]:shadow-md"
          >
            {segment.title}
          </a>
        ))
      }
    </div>
  </nav>

  {
    segments.map((segment, index) => (
      <section
        id={segment.id}
        class:list={['scroll-mt-32 py-20', index % 2 === 0 ? 'bg-white' : 'bg-gray-50']}
      >
        <div class="mx-auto max-w-7xl px-4 lg:px-8">
          {/* Coluna de texto com largura fixa em telas grandes: assim o cabeçalho e o
              parágrafo quebram no mesmo ponto em todas as seções, e as logos de cada
              segmento nascem sempre no mesmo eixo vertical, alinhadas ao topo do bloco. */}
          <div class="reveal flex max-w-5xl flex-col-reverse gap-6 sm:flex-row sm:items-start sm:gap-8 lg:gap-10">
            <div class="w-full min-w-0 sm:flex-1 lg:w-[48rem] lg:flex-none">
              <p class="text-sm font-bold tracking-widest text-red-ea uppercase">{segment.audience}</p>
              <h2 class="mt-2 text-4xl font-bold text-navy-700 sm:text-5xl">{segment.title}</h2>
              <p class="mt-3 font-display text-xl font-semibold text-gold-600">{segment.subtitle}</p>
              <p class="mt-4 text-lg leading-relaxed text-gray-600">{segment.description}</p>
            </div>
            {segment.logos && (
              <div class="flex w-full flex-wrap items-center justify-center gap-5 sm:w-40 sm:shrink-0 sm:flex-col sm:items-start sm:justify-start lg:w-48">
                {segment.logos.map((logo) => (
                  <img
                    src={logo.src}
                    alt={logo.alt}
                    width={logo.width}
                    height={logo.height}
                    class:list={['h-auto max-w-full object-contain', logo.sizeClass]}
                    loading="lazy"
                    decoding="async"
                    onerror="this.style.display='none'"
                  />
                ))}
              </div>
            )}
          </div>

          {segment.groups.length > 0 && (
            <div class="mt-10 grid gap-8">
              {segment.groups.map((group) => (
                /* Empilhadas, mas com a largura que tinham quando ficavam lado a
                   lado (metade do container menos o gap) — na largura total a
                   tabela, com poucas colunas, ficava esticada demais. */
                <div class="reveal lg:max-w-[592px]">
                  <h3 class="font-display text-lg font-bold text-navy-700">{group.label}</h3>

                  <!-- Mobile: um card por turma (a tabela de 4 colunas ficava espremida) -->
                  <div class="mt-4 space-y-3 sm:hidden">
                    {group.classes.map((turma) => (
                      <div
                        class:list={[
                          'card-glow rounded-2xl border bg-white p-5 shadow-sm',
                          turma.highlight ? 'border-gold-400 bg-gold-50' : 'border-gray-200',
                        ]}
                      >
                        <div class="flex flex-wrap items-center gap-2">
                          <span class="font-display text-lg font-bold text-navy-700">{turma.name}</span>
                          {turma.highlight && (
                            <span class="rounded-full bg-gold-400 px-2.5 py-0.5 text-xs font-bold whitespace-nowrap text-navy-900">
                              Mais rápida
                            </span>
                          )}
                        </div>
                        {turma.age && <p class="mt-0.5 text-xs text-gray-500">{turma.age}</p>}
                        <dl class="mt-3 grid grid-cols-3 gap-2 text-center">
                          <div class="rounded-xl bg-navy-50/70 px-1 py-2">
                            <dt class="text-[11px] font-bold tracking-wide text-gray-500 uppercase">Duração</dt>
                            <dd class="mt-0.5 text-sm font-semibold text-navy-800">{turma.duration}</dd>
                          </div>
                          <div class="rounded-xl bg-navy-50/70 px-1 py-2">
                            <dt class="text-[11px] font-bold tracking-wide text-gray-500 uppercase">Carga</dt>
                            <dd class="mt-0.5 text-sm font-semibold text-navy-800">{turma.hours}</dd>
                          </div>
                          <div class="rounded-xl bg-navy-50/70 px-1 py-2">
                            <dt class="text-[11px] font-bold tracking-wide text-gray-500 uppercase">Frequência</dt>
                            <dd class="mt-0.5 text-sm font-semibold text-navy-800">{turma.frequency}</dd>
                          </div>
                        </dl>
                      </div>
                    ))}
                  </div>

                  <!-- Tablet/desktop: tabela -->
                  <div class="card-glow mt-4 hidden overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm hover:shadow-md sm:block">
                    <table class="w-full text-left text-sm">
                      <thead>
                        <tr class="bg-navy-700 text-white">
                          <th scope="col" class="px-4 py-3 font-display">Turma</th>
                          <th scope="col" class="px-4 py-3 font-display">Duração</th>
                          <th scope="col" class="px-4 py-3 font-display">Carga Horária</th>
                          <th scope="col" class="px-4 py-3 font-display">Frequência</th>
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-gray-100">
                        {group.classes.map((turma) => (
                          <tr class:list={['transition hover:bg-navy-50/50', turma.highlight ? 'bg-gold-50' : '']}>
                            <td class="px-4 py-3.5">
                              <span class="font-display font-bold text-navy-700">{turma.name}</span>
                              {turma.highlight && (
                                <span class="ml-2 rounded-full bg-gold-400 px-2 py-0.5 text-xs font-bold text-navy-900">
                                  Mais rápida
                                </span>
                              )}
                              {turma.age && <p class="text-xs text-gray-500">{turma.age}</p>}
                            </td>
                            <td class="px-4 py-3.5 text-gray-600">{turma.duration}</td>
                            <td class="px-4 py-3.5 text-gray-600">{turma.hours}</td>
                            <td class="px-4 py-3.5 text-gray-600">{turma.frequency}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              ))}
            </div>
          )}

          {segment.id === 'online' && (
            <div class="reveal card-glow mt-10 rounded-2xl border border-navy-100 bg-navy-50 p-8 text-center">
              <p class="font-display text-xl font-bold text-navy-700">English Academy Live</p>
              <p class="mx-auto mt-2 max-w-xl text-gray-600">
                Aulas ao vivo com o Método Callan, de qualquer lugar do Brasil, na nossa plataforma exclusiva.
              </p>
              <a
                href={site.livePlatform}
                target="_blank"
                rel="noopener"
                class="btn-shine mt-5 inline-block rounded-full bg-navy-700 px-8 py-3.5 font-bold text-white shadow-md transition hover:bg-navy-600 hover:shadow-lg active:scale-[0.98]"
              >
                Conhecer a plataforma →
              </a>
            </div>
          )}
        </div>
      </section>
    ))
  }

  <!-- Por que mais carga horária -->
  <section class="bg-navy-800 py-20">
    <div class="mx-auto max-w-5xl px-4 text-center lg:px-8">
      <SectionHeading
        eyebrow="Economize conosco"
        title="Menor custo pela maior carga horária"
        subtitle="Enquanto escolas tradicionais oferecem cerca de 8 horas mensais, nossas turmas chegam a 20 horas por mês — quase o triplo. E o preço é fixo do início ao fim do contrato, sem aumentos a cada nível."
        light
      />
      <div class="reveal mt-10 grid gap-6 sm:grid-cols-3">
        <div data-tilt="5" class="card-glow rounded-2xl border border-white/10 bg-white/5 p-7 hover:bg-white/[0.08]">
          <p class="font-display text-4xl font-extrabold text-gold-400">até 20h</p>
          <p class="mt-2 text-sm text-navy-100">de aulas mensais nas turmas diárias</p>
        </div>
        <div data-tilt="5" class="card-glow rounded-2xl border border-white/10 bg-white/5 p-7 hover:bg-white/[0.08]">
          <p class="font-display text-4xl font-extrabold text-gold-400">Preço fixo</p>
          <p class="mt-2 text-sm text-navy-100">do início ao fim do contrato, sem reajustes por nível</p>
        </div>
        <div data-tilt="5" class="card-glow rounded-2xl border border-white/10 bg-white/5 p-7 hover:bg-white/[0.08]">
          <p class="font-display text-4xl font-extrabold text-gold-400">Material acessível</p>
          <p class="mt-2 text-sm text-navy-100">livros importados da Inglaterra pelo menor preço do mercado</p>
        </div>
      </div>
    </div>
  </section>

  <CTABand />

  <script>
    // Scroll-spy da navegação rápida: destaca a pílula da seção que está no
    // meio da tela e, no celular, rola a barra até ela (só na horizontal).
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-spy-link]'));
    const bar = document.getElementById('cursos-nav');
    const sections = links
      .map((link) => document.querySelector<HTMLElement>(link.getAttribute('href') ?? ''))
      .filter((section): section is HTMLElement => section !== null);

    if (links.length && sections.length && 'IntersectionObserver' in window) {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const setActive = (id: string) => {
        for (const link of links) {
          const active = link.getAttribute('href') === `#${id}`;
          if (active) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
          if (active && bar && bar.scrollWidth > bar.clientWidth) {
            bar.scrollTo({
              left: link.offsetLeft - bar.clientWidth / 2 + link.offsetWidth / 2,
              behavior: reduceMotion ? 'auto' : 'smooth',
            });
          }
        }
      };
      // Seções que cruzam a faixa central agora; sem nenhuma (topo da página,
      // no hero), nenhuma pílula fica destacada.
      const visible = new Set<string>();
      const spy = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) visible.add(entry.target.id);
            else visible.delete(entry.target.id);
          }
          setActive(sections.find((section) => visible.has(section.id))?.id ?? '');
        },
        // Faixa estreita no meio da tela: só uma seção "está ativa" por vez
        { rootMargin: '-40% 0px -55% 0px' }
      );
      sections.forEach((section) => spy.observe(section));
    }
  </script>
</BaseLayout>
