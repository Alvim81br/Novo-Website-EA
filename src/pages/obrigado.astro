---
// Página de confirmação do formulário de aula experimental.
// É o ponto de conversão que GA4/Meta usam para otimizar campanhas:
// ao carregar, dispara `generate_lead` (uma vez por visita).
// Fica fora do índice (noindex + fora do sitemap, ver astro.config.mjs).
import BaseLayout from '../layouts/BaseLayout.astro';
import { units, defaultWhatsappLink } from '../data/units';
import { site } from '../data/site';

// Mapa unidade → link de WhatsApp para o botão falar com a unidade certa
// (o formulário envia o nome da unidade em ?u=).
const waByName = Object.fromEntries(units.map((unit) => [unit.name, unit.whatsappLink]));
---

<BaseLayout
  title="Pedido recebido! — Aula Experimental Grátis | English Academy"
  description="Recebemos seu pedido de aula experimental gratuita. Nossa equipe vai te chamar no WhatsApp para confirmar o melhor dia e horário."
  noindex
>
  <section class="hero-grad-aula relative overflow-hidden py-20 lg:py-24">
    <div class="absolute inset-0" aria-hidden="true">
      <div class="animate-float-diamond absolute top-[16%] left-[12%] hidden h-16 w-16 rounded-xl border-2 border-gold-400/35 lg:block"></div>
      <div class="absolute -bottom-10 right-[8%] h-40 w-40 rounded-full border-2 border-white/10"></div>
      <span class="animate-twinkle absolute top-[22%] right-[24%] text-2xl text-gold-300/70">✦</span>
      <span class="animate-twinkle-slow absolute bottom-[28%] left-[30%] text-base text-white/40">✦</span>
      <div class="absolute -right-24 -bottom-24 h-96 w-96 rounded-full bg-red-ea/25 blur-3xl"></div>
    </div>

    <div
      id="obrigado-root"
      class="relative mx-auto max-w-3xl px-4 text-center lg:px-8"
      data-wa-map={JSON.stringify(waByName)}
      data-wa-default={defaultWhatsappLink}
    >
      <span
        class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-gold-400 text-navy-900 shadow-xl"
        aria-hidden="true"
      >
        <svg class="h-10 w-10" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
        </svg>
      </span>
      <h1 class="mt-6 text-4xl font-extrabold text-white sm:text-5xl">Pedido recebido! 🎉</h1>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-navy-100">
        Sua aula experimental gratuita está a um passo: nossa equipe vai te chamar no
        <strong class="text-white">WhatsApp em breve</strong> para confirmar o melhor dia e horário.
      </p>
      <p id="obrigado-unidade" hidden class="mt-3 text-sm font-semibold text-gold-300"></p>

      <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          id="obrigado-wa"
          href={defaultWhatsappLink}
          target="_blank"
          rel="noopener"
          class="btn-shine w-full rounded-full bg-red-ea px-8 py-4 text-base font-bold text-white shadow-lg shadow-red-ea/30 transition hover:bg-red-ea-dark hover:shadow-xl sm:w-auto"
        >
          Chamar a unidade no WhatsApp agora
        </a>
        <a
          href={site.social.instagram}
          target="_blank"
          rel="noopener"
          class="w-full rounded-full border-2 border-white/30 px-8 py-4 text-base font-bold text-white transition hover:border-white hover:bg-white/10 sm:w-auto"
        >
          Seguir @english_academy_br
        </a>
      </div>
      <p class="mt-5 text-sm text-navy-200">
        Dica: salve nosso contato para não perder a mensagem de confirmação. 😉
      </p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-5xl px-4 lg:px-8">
      <h2 class="text-center text-3xl font-bold text-navy-700 sm:text-4xl">E agora, o que acontece?</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        <div class="rounded-2xl border border-gray-100 bg-white p-7 text-center shadow-sm">
          <p class="font-display text-4xl font-extrabold text-gold-500">1</p>
          <h3 class="mt-2 font-display text-lg font-bold text-navy-700">Confirmação</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">
            A unidade escolhida te chama no WhatsApp para combinar o melhor dia e horário.
          </p>
        </div>
        <div class="rounded-2xl border border-gray-100 bg-white p-7 text-center shadow-sm">
          <p class="font-display text-4xl font-extrabold text-gold-500">2</p>
          <h3 class="mt-2 font-display text-lg font-bold text-navy-700">Sua aula</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">
            45 minutos de aula de verdade com nossos professores — presencial ou online, você escolhe.
          </p>
        </div>
        <div class="rounded-2xl border border-gray-100 bg-white p-7 text-center shadow-sm">
          <p class="font-display text-4xl font-extrabold text-gold-500">3</p>
          <h3 class="mt-2 font-display text-lg font-bold text-navy-700">Sem compromisso</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">
            Você vive a experiência do Método Callan e decide com calma — nenhuma obrigação de matrícula.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Personaliza o botão de WhatsApp com a unidade escolhida no formulário
    // e registra a conversão (uma vez por visita).
    const root = document.getElementById('obrigado-root');
    const params = new URLSearchParams(location.search);
    const unitName = params.get('u') ?? '';
    const via = params.get('via') ?? 'form';

    if (root && unitName) {
      try {
        const map = JSON.parse(root.dataset.waMap ?? '{}') as Record<string, string>;
        const link = map[unitName];
        const button = document.getElementById('obrigado-wa') as HTMLAnchorElement | null;
        if (link && button) button.href = link;
        const label = document.getElementById('obrigado-unidade');
        if (label) {
          label.textContent = `Unidade escolhida: ${unitName}`;
          label.hidden = false;
        }
      } catch {}
    }

    try {
      if (!sessionStorage.getItem('ea-lead-fired')) {
        (window as any).eaTrack?.('generate_lead', { method: via, unit: unitName || undefined });
        sessionStorage.setItem('ea-lead-fired', '1');
      }
    } catch {
      (window as any).eaTrack?.('generate_lead', { method: via });
    }
  </script>
</BaseLayout>
